{
  "name": "lavadero",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "back_end*",
    "front_end*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=back_end",
    "dev:backend": "npm run dev --workspace=back_end",
    "dev:frontend": "npm run dev --workspace=front_end",
    "dev:all": "concurrently -n BE,FE -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm run build --workspace=back_end && npm run build --workspace=front_end",
    "build:netlify": "npm run build --workspace=front_end",
    "start": "npm run start --workspace=back_end",
    "test": "npm run test --workspace=back_end"
  },
  "dependencies": {
    "react-is": "^19.2.8",
    "media-typer": "1.1.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  },
  "overrides": {
    "media-typer": "1.1.1"
  }
}
